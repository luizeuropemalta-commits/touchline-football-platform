project-quarantine
# Local package cache and audit deliveries are never runtime inputs. Excluding
# them keeps Vercel deployments limited to the executable TouchLine product.
.pnpm-store
# Local review renders are preserved on this Mac but never uploaded as part of
# the application bundle. Approved media must use its dedicated storage path.
# Keep local render outputs out of Vercel. The three factual replay records below
# are not media: they are the checked-in, fail-closed inputs required by the
# approval-only Match Preview contract test during a production build.
artifacts
!artifacts/
!artifacts/social-studio/
artifacts/social-studio/*
!artifacts/social-studio/rankings/
!artifacts/social-studio/rankings/match-preview-leaders-20260914.json
!artifacts/social-studio/rankings/match-preview-card-revalidation-20260915.json
!artifacts/social-studio/match-preview/
!artifacts/social-studio/match-preview/2026-09-14-brentford-chelsea-factual-capture.json
# Documentation remains excluded from deployments, except for the two small
# canonical governance inputs required by the release preflight itself.
docs/*
!docs/touchline
docs/touchline/*
!docs/touchline/project-memory
docs/touchline/project-memory/*
!docs/touchline/project-memory/TOUCHLINE_MISSION_FOOTER.md
!docs/touchline/project-memory/TOUCHLINE_CODEX_PROMPT_TEMPLATE.md
# Module 046 hashes this exact checked-in lexicon during the QA build. Keep the
# single canonical input available without shipping the rest of the playbook.
!docs/touchline-arena
docs/touchline-arena/*
!docs/touchline-arena/social-publishing-playbook
docs/touchline-arena/social-publishing-playbook/*
!docs/touchline-arena/social-publishing-playbook/CANONICAL_SOCIAL_ICON_LEXICON.md
!docs/touchline-arena/social-publishing-playbook/041_MATCH_PREVIEW_OWNER_ART_APPROVAL.md
