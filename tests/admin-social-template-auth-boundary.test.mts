import assert from'node:assert/strict';import test from'node:test';import{readFileSync}from'node:fs';import vm from'node:vm';import ts from'typescript';
function fixture(mode='ok'){
 const calls={admins:0,rpc:[]as unknown[]};const exports:Record<string,(r:unknown)=>Promise<Response>>={};const actor='11111111-1111-4111-8111-111111111111';
 const dependencies:Record<string,unknown>={
 'next/server':{NextResponse:{json:Response.json}},'@/lib/admin/owner':{isOwnerEmail:()=>mode!=='customer'},'@/lib/touchlineArena/auth-access':{hasTouchLineArenaAccess:()=>mode!=='no-access'},
 '@/lib/supabase/server':{createClient:async()=>({auth:{getUser:async()=>{if(mode==='auth-throw')throw Error('PRIVATE_AUTH');return{data:{user:mode==='anonymous'?null:{id:actor,email:'owner@synthetic.invalid'}},error:mode==='auth-error'?{}:null};}},rpc:async(name:string,args:unknown)=>{calls.rpc.push({name,args});if(mode==='rpc-throw')throw Error('PRIVATE_RPC');return{data:{outcome:'updated',scopeKey:'GLOBAL',killSwitchEngaged:true,blockedCandidates:0,outboundMode:'DISABLED'},error:null};}})},
 '@/lib/supabase/admin':{createAdminClient:()=>{calls.admins++;return{};}},
 '@/lib/touchlineArena/social-artifact-storage-server':{assertTouchlineSocialQaRuntime:()=>{if(mode==='not-qa')throw Error('not qa');},createTouchlineSocialArtifactStorageFromEnvironment:()=>{throw Error('unexpected storage');}},
 '@/lib/touchlineArena/social-publication-contract':{verifyTouchlineSocialStoredArtifact:()=>{throw Error('unexpected artifact');}},
 };
 const source=readFileSync(new URL('../app/api/admin/social-publications/template-policy/route.ts',import.meta.url),'utf8');vm.runInNewContext(ts.transpileModule(source,{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText,{exports,URL,TextDecoder,setTimeout:(fn:()=>void)=>setTimeout(fn,5),clearTimeout,require:(s:string)=>{assert.ok(s in dependencies,s);return dependencies[s];}});
 const request=Object.assign(new Request('https://qa.invalid/api',{method:'POST',headers:{origin:'https://qa.invalid','content-type':'application/json'},body:JSON.stringify({action:'set-delivery-control',scopeKey:'GLOBAL',killSwitchEngaged:true,dailyQuota:10,minimumGapSeconds:60,actorId:'forged'})}),{nextUrl:new URL('https://qa.invalid/api')});return{calls,post:exports.POST,run:()=>exports.POST(request),actor};
}
test('social policy rejects error-bearing owner/auth throws without admin or RPC',async()=>{for(const mode of ['auth-error','auth-throw','customer','no-access','anonymous']){const h=fixture(mode);const r=await h.run();assert.ok(r.status>=400);assert.equal(h.calls.admins,0);assert.equal(h.calls.rpc.length,0);assert.ok(!(await r.text()).includes('PRIVATE'));}});
test('social policy remains QA-only and preserves actor-bound valid delivery command',async()=>{const denied=fixture('not-qa');assert.equal((await denied.run()).status,404);assert.equal(denied.calls.admins,0);const h=fixture();assert.equal((await h.run()).status,200);assert.equal(h.calls.rpc.length,1);const c=h.calls.rpc[0]as{name:string;args:{p_actor_id:string;p_kill_switch_engaged:boolean}};assert.equal(c.name,'touchline_social_046_set_delivery_control');assert.equal(c.args.p_actor_id,h.actor);assert.equal(c.args.p_kill_switch_engaged,true);});
test('social policy RPC exception returns uncertain safe error without private details',async()=>{const h=fixture('rpc-throw');const r=await h.run();assert.equal(r.status,503);assert.equal(h.calls.rpc.length,1);const body=await r.json();assert.notEqual(body.ok,true);assert.ok(!JSON.stringify(body).includes('PRIVATE_RPC'));});

function policyRequest(body:BodyInit,headers:Record<string,string>={}){return Object.assign(new Request('https://qa.invalid/api',{method:'POST',headers:{origin:'https://qa.invalid','content-type':'application/json',...headers},body,duplex:'half'} as RequestInit),{nextUrl:new URL('https://qa.invalid/api')});}
test('social policy validates JSON media, object and byte limit without commands',async()=>{for(const [body,headers,status]of [['{}',{'content-type':'text/plain'},415],['{}',{'content-type':'application/jsonp'},415],['null',{},400],['[]',{},400],['42',{},400],['{',{},400],[' '.repeat(4097),{},400],['{}',{'content-length':'1'},400]]as[string,Record<string,string>,number][]){const h=fixture();const r=await h.post(policyRequest(body,headers));assert.equal(r.status,status);assert.equal(h.calls.admins,0);assert.equal(h.calls.rpc.length,0);}});
test('social policy stream deadline and overflow cancel and release before protected work',async()=>{for(const overflow of [false,true]){const h=fixture();let cancelled=false;let control:ReadableStreamDefaultController<Uint8Array>|undefined;const body=new ReadableStream<Uint8Array>({start(c){control=c;c.enqueue(overflow?new Uint8Array(4097):new TextEncoder().encode('{'));},cancel(){cancelled=true;}});const pending=h.post(policyRequest(body));let timer:ReturnType<typeof setTimeout>|undefined;const r=await Promise.race([pending,new Promise<null>(resolve=>{timer=setTimeout(()=>resolve(null),100);})]);clearTimeout(timer);if(!r){control!.close();await pending;}assert.notEqual(r,null);assert.equal(r!.status,400);assert.equal(cancelled,true);assert.equal(body.locked,false);assert.equal(h.calls.admins,0);assert.equal(h.calls.rpc.length,0);}});
test('social policy accepts bounded UTF8 JSON with charset at exact byte limit',async()=>{const h=fixture();const body=JSON.stringify({action:'set-delivery-control',scopeKey:'GLOBAL',killSwitchEngaged:true,dailyQuota:10,minimumGapSeconds:60}).padEnd(4096,' ');assert.equal((await h.post(policyRequest(body,{'content-type':'application/json; charset=utf-8'}))).status,200);assert.equal(h.calls.rpc.length,1);});
