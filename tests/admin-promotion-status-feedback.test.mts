function fixture(locale:string){let index=0,reloads=0;const state:unknown[]=[];let failure='http';const requests:unknown[]=[];const exports:Record<string,unknown>={};runInNewContext(code,{exports,require:(name:string)=>name==='react'?{...React,useState:(initial:unknown)=>{const slot=index++;if(!(slot in state))state[slot]=initial;return[state[slot],(next:unknown)=>{state[slot]=next;}];}}:name==='react/jsx-runtime'?jsx:{Gift:()=>null,Plus:()=>null},fetch:async(_url:string,init:unknown)=>{requests.push(init);if(failure==='network')throw Error('PRIVATE_DIAGNOSTIC');return{ok:failure==='none',json:async()=>({ok:failure==='none',error:'PRIVATE_DIAGNOSTIC'})};},window:{location:{reload:()=>{reloads++;}}}});const Component=exports.PromotionStatusActions as (p:unknown)=>React.ReactElement;return{render:()=>{index=0;return Component({promotionId:'synthetic',locale});},failure:(value:string)=>{failure=value;},reloads:()=>reloads,requests};}
