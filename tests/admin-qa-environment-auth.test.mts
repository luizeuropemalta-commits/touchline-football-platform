import assert from'node:assert/strict';import test from'node:test';import{readFileSync}from'node:fs';import vm from'node:vm';import ts from'typescript';
function fixture(mode='ok'){
 const calls={admins:0,rpc:0,auth:0};const exports:Record<string,(r:unknown)=>Promise<Response>>={};const deps:Record<string,unknown>={
 'next/server':{NextResponse:{json:Response.json}},'@/lib/admin/owner':{isOwnerEmail:()=>mode!=='customer'},'@/lib/touchlineArena/auth-access':{hasTouchLineArenaAccess:()=>mode!=='no-access'},
 '@/lib/supabase/server':{createClient:async()=>{if(mode==='client-throw')throw Error('PRIVATE_CLIENT');if(mode==='no-client')return null;return{auth:{getUser:async()=>{calls.auth++;if(mode==='auth-throw')throw Error('PRIVATE_AUTH');return{data:{user:mode==='anonymous'?null:{id:'synthetic',email:'owner@synthetic.invalid'}},error:mode==='auth-error'?{message:'PRIVATE_AUTH'}:null};}}};}},
 '@/lib/supabase/admin':{createAdminClient:()=>{calls.admins++;if(mode==='admin-throw')throw Error('PRIVATE_ADMIN');return{rpc:async()=>{calls.rpc++;if(mode==='rpc-throw')throw Error('PRIVATE_RPC');return{error:mode==='rpc-error'?{message:'PRIVATE_RPC'}:null};}};}},
 '@/lib/touchlinePreview/qa-environment-verifier-server':{TOUCHLINE_QA_SUPABASE_PROJECT_REF:'synthetic-ref',inspectTouchlineQaVercelEnvironment:()=>mode==='not-qa'?{status:'FAIL',reason:'INVALID_RUNTIME'}:{status:'PASS',reason:'VERIFIED'}},
 };const source=readFileSync(new URL('../app/api/admin/qa-environment/route.ts',import.meta.url),'utf8');vm.runInNewContext(ts.transpileModule(source,{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText,{exports,process:{env:{}},require:(s:string)=>{assert.ok(s in deps,s);return deps[s];}});return{calls,run:()=>exports.GET({nextUrl:new URL('https://qa.invalid/api')})};
}
test('QA verification never returns PASS or calls privileged verifier for failed authentication',async()=>{for(const mode of ['auth-error','auth-throw','client-throw','no-client','customer','no-access','anonymous']){const h=fixture(mode);const r=await h.run();assert.ok(r.status>=400);const body=await r.json();assert.equal(body.status,'FAIL');assert.deepEqual(Object.keys(body).sort(),['reason','status']);assert.ok(!JSON.stringify(body).includes('PRIVATE'));assert.equal(h.calls.admins,0);assert.equal(h.calls.rpc,0);}});
test('QA verifier runtime gate and healthy owner preserve exact two-field verdict',async()=>{const off=fixture('not-qa');assert.equal((await off.run()).status,404);assert.equal(off.calls.auth,0);const h=fixture();const r=await h.run();assert.equal(r.status,200);assert.deepEqual(await r.json(),{status:'PASS',reason:'QA_ENVIRONMENT_AND_CREDENTIALS_VERIFIED'});assert.equal(h.calls.rpc,1);assert.match(r.headers.get('cache-control')!,/no-store/);});
test('QA verifier privileged setup failures remain generic FAIL without private details',async()=>{for(const mode of ['admin-throw','rpc-throw','rpc-error']){const h=fixture(mode);const r=await h.run();assert.equal(r.status,503);const b=await r.json();assert.equal(b.status,'FAIL');assert.ok(!JSON.stringify(b).includes('PRIVATE'));}});
