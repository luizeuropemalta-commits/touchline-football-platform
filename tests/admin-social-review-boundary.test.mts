import assert from'node:assert/strict';import test from'node:test';import{readFileSync}from'node:fs';import vm from'node:vm';import ts from'typescript';
function fixture(mode='ok'){
 const calls={admins:0,reads:0};const exports:Record<string,(r:unknown)=>Promise<Response>>={};const actor='11111111-1111-4111-8111-111111111111';
 const query={select:()=>query,eq:()=>query,maybeSingle:async()=>{calls.reads++;if(mode==='db-throw')throw Error('PRIVATE_DB');return{data:null,error:null};}};
 const deps:Record<string,unknown>={
 'next/server':{NextResponse:{json:Response.json}},'@/lib/admin/owner':{isOwnerEmail:()=>mode!=='customer'},'@/lib/touchlineArena/auth-access':{hasTouchLineArenaAccess:()=>mode!=='no-access'},
 '@/lib/supabase/server':{createClient:async()=>({auth:{getUser:async()=>{if(mode==='auth-throw')throw Error('PRIVATE_AUTH');return{data:{user:mode==='anonymous'?null:{id:actor,email:'synthetic'}},error:mode==='auth-error'?{}:null};}}})},
 '@/lib/supabase/admin':{createAdminClient:()=>{calls.admins++;return{from:()=>query};}},
 '@/lib/touchlineArena/social-artifact-storage-server':{assertTouchlineSocialQaRuntime:()=>{if(mode==='not-qa')throw Error('qa');}},
 };
 const source=readFileSync(new URL('../app/api/admin/social-publications/review/route.ts',import.meta.url),'utf8');vm.runInNewContext(ts.transpileModule(source,{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText,{exports,URL,TextDecoder,setTimeout:(fn:()=>void)=>setTimeout(fn,5),clearTimeout,require:(s:string)=>{if(s in deps)return deps[s];assert.ok(s.startsWith('@/lib/touchlineArena/social-'),s);return new Proxy({},{get:()=>()=>{throw Error('unexpected producer');}});}});
 const body=JSON.stringify({action:'approve-caption',draftId:actor,expectedChecksum:'sha256:'+'a'.repeat(64),expectedManifestChecksum:'sha256:'+'b'.repeat(64)});
 const request=(text:BodyInit=body,headers:Record<string,string>={})=>Object.assign(new Request('https://qa.invalid/api',{method:'POST',headers:{origin:'https://qa.invalid','content-type':'application/json',...headers},body:text,duplex:'half'}as RequestInit),{nextUrl:new URL('https://qa.invalid/api')});return{calls,post:exports.POST,request};
}
test('review auth failures do not construct admin or read drafts',async()=>{for(const mode of ['auth-error','auth-throw','anonymous','customer','no-access']){const h=fixture(mode);const r=await h.post(h.request());assert.ok(r.status>=400);assert.equal(h.calls.admins,0);assert.equal(h.calls.reads,0);assert.ok(!(await r.text()).includes('PRIVATE'));}});
test('review keeps QA and draft checks while sanitizing read exceptions',async()=>{const off=fixture('not-qa');assert.equal((await off.post(off.request())).status,404);assert.equal(off.calls.admins,0);const ok=fixture();assert.equal((await ok.post(ok.request())).status,409);assert.equal(ok.calls.reads,1);const bad=fixture('db-throw');const r=await bad.post(bad.request());assert.equal(r.status,503);assert.ok(!(await r.text()).includes('PRIVATE_DB'));});
test('review media and bounded object input reject before admin',async()=>{for(const [body,headers,status]of [['{}',{'content-type':'text/plain'},415],['null',{},400],['[]',{},400],[' '.repeat(4097),{},400]]as[string,Record<string,string>,number][]){const h=fixture();assert.equal((await h.post(h.request(body,headers))).status,status);assert.equal(h.calls.admins,0);}});
test('review incomplete stream times out with cancellation and no protected read',async()=>{const h=fixture();let cancelled=false;let c:ReadableStreamDefaultController<Uint8Array>|undefined;const body=new ReadableStream<Uint8Array>({start(controller){c=controller;controller.enqueue(new TextEncoder().encode('{'));},cancel(){cancelled=true;}});const work=h.post(h.request(body));let timer:ReturnType<typeof setTimeout>|undefined;const r=await Promise.race([work,new Promise<null>(resolve=>{timer=setTimeout(()=>resolve(null),100);})]);clearTimeout(timer);if(!r){c!.close();await work;}assert.notEqual(r,null);assert.equal(r!.status,400);assert.equal(cancelled,true);assert.equal(body.locked,false);assert.equal(h.calls.admins,0);});
