import test from 'node:test';
import assert from 'node:assert/strict';
import {processClubSeasonWebhook,readSeasonWebhookBody,type SeasonWebhookSubject,type SeasonWebhookOrder,type SeasonWebhookStore} from '../lib/stripe/club-season-webhook-service.ts';
import {CLUB_SEASON_TEST_ACCOUNT,CLUB_SEASON_TEST_CATALOGUE} from '../lib/stripe/club-season-test-catalogue.ts';
const now=Date.parse('2026-10-29T12:00:00Z');
const order:SeasonWebhookOrder={id:'11111111-1111-4111-8111-111111111111',userId:'22222222-2222-4222-8222-222222222222',seasonId:'33333333-3333-4333-8333-333333333333',plan:'standard',sessionId:'cs_test_one',seasonStartsAt:'2026-08-01',seasonEndsAt:'2027-06-01',state:'pending'};
function subject():SeasonWebhookSubject {const p=CLUB_SEASON_TEST_CATALOGUE.standard;return {orderId:order.id,sessionId:order.sessionId,ownerId:order.userId,seasonId:order.seasonId,plan:order.plan,kind:'payment',evidence:{accountId:CLUB_SEASON_TEST_ACCOUNT,id:order.sessionId,livemode:false,mode:'payment',status:'complete',payment_status:'paid',currency:'eur',amount_total:p.amountMinor,amount_subtotal:p.amountMinor,total_details:{amount_tax:0,amount_discount:0,amount_shipping:0},client_reference_id:order.userId,metadata:{touchlineOrderId:order.id,touchlineSeasonId:order.seasonId,touchlinePlan:'standard'},lines:{has_more:false,data:[{quantity:1,price:{id:p.priceId,product:p.productId,active:true,livemode:false,currency:'eur',unit_amount:p.amountMinor,recurring:null}}]}}};}
function fixture(o={...order}) {const calls:unknown[][]=[];const store:SeasonWebhookStore={read:async()=>o,fulfill:async(...a)=>{calls.push(['fulfill',...a]);o.state='paid';},review:async(...a)=>{calls.push(['review',...a]);o.state='review';},expire:async(...a)=>{calls.push(['expire',...a]);o.state='expired';}};return {store,calls};}
test('first paid delivery is committed once; replay never credits again',async()=>{const f=fixture();await processClubSeasonWebhook('evt_one',subject(),f.store,now);await processClubSeasonWebhook('evt_two',subject(),f.store,now);assert.equal(f.calls.length,1);assert.equal(f.calls[0][0],'fulfill');});
test('provider owner/session/season mismatches and unpaid evidence cannot mutate',async()=>{for(const patch of [{ownerId:'other'},{sessionId:'cs_test_other'},{seasonId:'other'},{plan:'vip'},{previousPaidPlan:'standard'}]){const f=fixture();await assert.rejects(processClubSeasonWebhook('evt_one',{...subject(),...patch},f.store,now),/SEASON_EVENT_MISMATCH/);assert.equal(f.calls.length,0);}const f=fixture(),s=subject();s.evidence!.payment_status='unpaid';await assert.rejects(processClubSeasonWebhook('evt_one',s,f.store,now),/UNCONFIRMED/);assert.equal(f.calls.length,0);});
test('risk before completion keeps later payment from crediting; unrelated events ignored',async()=>{const f=fixture();await processClubSeasonWebhook('evt_refund',{...subject(),kind:'risk',riskType:'charge.refunded'},f.store,now);await processClubSeasonWebhook('evt_complete',subject(),f.store,now);assert.equal(f.calls.length,1);await processClubSeasonWebhook('evt_other',null,f.store,now);assert.equal(f.calls.length,1);});
test('late first payment is recorded for review, never grants expired season',async()=>{const f=fixture({...order,seasonEndsAt:'2026-10-29T11:59:59Z'});await processClubSeasonWebhook('evt_late',subject(),f.store,now);assert.equal(f.calls[0][0],'review');assert.equal(f.calls[0][3],'season.payment_late');});
test('storage failure propagates for webhook retry instead of false acknowledgement',async()=>{const f=fixture();f.store.fulfill=async()=>{throw new Error('db');};await assert.rejects(processClubSeasonWebhook('evt_one',subject(),f.store,now),/db/);});
test('bounded raw body preserves signature bytes and rejects excess bytes',async()=>{const body=' { "x": "á" }\n';assert.equal(await readSeasonWebhookBody(new Request('https://test',{method:'POST',body})),body);await assert.rejects(readSeasonWebhookBody(new Request('https://test',{method:'POST',body:'12345'}),4),/INVALID_BODY/);});
