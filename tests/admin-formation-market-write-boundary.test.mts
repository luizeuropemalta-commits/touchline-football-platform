import assert from 'node:assert/strict';import test from 'node:test';import{readFileSync}from'node:fs';import vm from'node:vm';import ts from'typescript';
const actor='11111111-1111-4111-8111-111111111111';
function fixture(sector:'formation'|'market',mode='ok',receipt?:unknown){
 const calls={admins:0,writes:[]as unknown[]};const exports:Record<string,(r:unknown)=>Promise<Response>>={};
 let selectedId='';
 const result=()=>{if(mode==='backend')throw Error('PRIVATE_BACKEND');const patch=calls.writes.at(-1)as Record<string,unknown>;return{error:null,data:mode==='missing-row'?null:{id:mode==='wrong-row'?'other':selectedId,...patch}};};
 const chain={update:(c:unknown)=>{calls.writes.push(c);return chain;},eq:(_column:string,id:string)=>{selectedId=id;return chain;},select:()=>chain,maybeSingle:async()=>result(),then:(resolve:(value:unknown)=>unknown,reject:(error:unknown)=>unknown)=>Promise.resolve().then(result).then(resolve,reject)};
 const deps:Record<string,unknown>={
 'next/server':{NextResponse:{json:Response.json}},'@/lib/admin/owner':{isOwnerEmail:()=>mode!=='customer'},'@/lib/touchlineArena/auth-access':{hasTouchLineArenaAccess:()=>true},
 '@/lib/supabase/server':{createClient:async()=>({auth:{getUser:async()=>{if(mode==='throw')throw Error('PRIVATE_AUTH');return{data:{user:{id:actor,email:'synthetic'}},error:mode==='auth-error'?{}:null};}}})},
 '@/lib/supabase/admin':{createAdminClient:()=>{calls.admins++;return{from:()=>chain,rpc:async(_n:string,c:unknown)=>{calls.writes.push(c);if(mode==='backend')throw Error('PRIVATE_BACKEND');return{data:receipt!==undefined?receipt:mode==='empty-receipt'?[{}]:[{formation_code:'4-3-3',geometry_version:2,status:'published',published_at:'2026-01-01',rollback_of_version:1}],error:null};}};}},
 '@/lib/touchlineArena/server-read-deadline':{resolveServerReadWithin:async(p:Promise<unknown>,fallback:unknown)=>p.catch(()=>fallback)},
 '@/lib/touchlineArena/formation-geometry':{},'@/lib/touchlineArena/card-engine-batch-server':{createTouchlineCardEngineBatch:async(_a:unknown,c:unknown)=>{calls.writes.push(c);return{id:'batch'};}},'@/lib/touchlineArena/card-engine-candidates-server':{loadTouchlineCardEngineCandidates:async()=>[]},'@/lib/touchlineArena/card-engine-market-value-batch':{prepareTouchlineMarketValueCardEngineRows:()=>[],touchlineMarketValueBatchContentIdentity:()=> 'identity'},'@/lib/touchlineArena/card-engine-editorial-import':{CARD_ENGINE_IMPORT_MAX_ROWS:500,summarizeCardEngineRows:()=>({review:0})},
 };
 const path=sector==='formation'?'formation-geometries':'market-values/import';const source=readFileSync(new URL(`../app/api/admin/${path}/route.ts`,import.meta.url),'utf8');vm.runInNewContext(ts.transpileModule(source,{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText,{exports,TextEncoder,TextDecoder,Uint8Array,Error,setTimeout:(fn:()=>void)=>setTimeout(fn,5),clearTimeout,require:(s:string)=>{assert.ok(s in deps,s);return deps[s];}});
 const command=sector==='formation'?{action:'rollback',formationCode:'4-3-3',targetVersion:1,reason:'Reviewed'}:{action:'reject',itemId:'synthetic',reason:'Reviewed'};
 const request=(headers:Record<string,string>={})=>Object.assign(new Request('https://qa.invalid/api',{method:'POST',headers:{origin:'https://qa.invalid','content-type':'application/json',...headers},body:JSON.stringify(command)}),{nextUrl:new URL('https://qa.invalid/api')});
 return{calls,request,post:exports.POST,run:sector==='formation'?exports.POST:exports.PATCH};
}
for(const sector of ['formation','market']as const){
 test(`${sector} refuses absent origin/media and error-bearing auth`,async()=>{for(const headers of [{origin:''},{'content-type':'text/plain'},{'content-type':'application/jsonp'}]){const h=fixture(sector);assert.equal((await h.run(h.request(headers))).status,'origin'in headers?403:415);assert.equal(h.calls.admins,0);}for(const mode of ['auth-error','throw','customer']){const h=fixture(sector,mode);const r=await h.run(h.request());assert.ok(r.status>=400);assert.equal(h.calls.admins,0);assert.equal(h.calls.writes.length,0);assert.ok(!(await r.text()).includes('PRIVATE_'));}});
 test(`${sector} valid command preserved and backend exceptions generic`,async()=>{const h=fixture(sector);assert.equal((await h.run(h.request())).status,200);assert.equal(h.calls.writes.length,1);const failed=fixture(sector,'backend');const r=await failed.run(failed.request());assert.ok(r.status>=400);assert.ok(!(await r.text()).includes('PRIVATE_BACKEND'));});
 test(`${sector} stalled and overflowing bodies are cancelled without commands`,async()=>{for(const oversized of [false,true]){const h=fixture(sector);let cancelled=false;let c:ReadableStreamDefaultController<Uint8Array>|undefined;const body=new ReadableStream<Uint8Array>({start(controller){c=controller;controller.enqueue(oversized?new Uint8Array(270000):new TextEncoder().encode('{'));},cancel(){cancelled=true;}});const pending=h.run({nextUrl:new URL('https://qa.invalid/api'),headers:new Headers({origin:'https://qa.invalid','content-type':'application/json'}),body,text:async()=>{throw Error('whole-body buffering forbidden');}});let timer:ReturnType<typeof setTimeout>|undefined;const result=await Promise.race([pending,new Promise<null>(r=>{timer=setTimeout(()=>r(null),100);})]);clearTimeout(timer);if(!result){c!.close();await pending;}assert.notEqual(result,null);assert.ok(result!.status>=400);assert.equal(cancelled,true);assert.equal(body.locked,false);assert.equal(h.calls.writes.length,0);}});
}

test('market POST enforces guards and preserves legitimate review-only batch actor',async()=>{for(const headers of [{origin:''},{'content-type':'text/plain'}]){const h=fixture('market');assert.ok((await h.post(h.request(headers))).status>=400);assert.equal(h.calls.admins,0);}const denied=fixture('market','auth-error');assert.equal((await denied.post(denied.request())).status,403);assert.equal(denied.calls.admins,0);const h=fixture('market');const req=Object.assign(new Request('https://qa.invalid/api',{method:'POST',headers:{origin:'https://qa.invalid','content-type':'application/json; charset=utf-8'},body:JSON.stringify({scope:'player',verifiedSeason:'2026-27',jobKey:'manual_emergency_player_import',source:'manual_approval',rows:[{playerId:actor,marketValueEur:100,currency:'EUR'}]})}),{nextUrl:new URL('https://qa.invalid/api')});const result=await h.post(req);assert.equal(result.status,200);assert.equal((await result.json()).nextAction,'review_in_card_engine');assert.equal((h.calls.writes[0]as{actorId:string}).actorId,actor);});

test('market map/reject confirm the affected row instead of reporting zero-row success',async()=>{for(const action of ['map','reject'])for(const mode of ['missing-row','wrong-row','ok']){const h=fixture('market',mode);const req=Object.assign(new Request('https://qa.invalid/api',{method:'PATCH',headers:{origin:'https://qa.invalid','content-type':'application/json'},body:JSON.stringify({action,itemId:'synthetic',playerId:actor,reason:'Reviewed'})}),{nextUrl:new URL('https://qa.invalid/api')});const response=await h.run(req);assert.equal(response.status,mode==='missing-row'?404:mode==='wrong-row'?503:200);const body=await response.json();assert.equal(body.ok===true,mode==='ok');assert.equal(h.calls.writes.length,1);}});

test('formation cannot confirm a malformed persisted receipt',async()=>{const f=fixture('formation','empty-receipt');const response=await f.run(f.request());assert.equal(response.status,503);assert.equal((await response.json()).ok,false);});

test('formation rejects mismatched formation, rollback identity and malformed published revision',async()=>{
 const row={formation_code:'4-3-3',geometry_version:2,status:'published',published_at:'2026-01-01',rollback_of_version:1};
 for(const patch of [{formation_code:'4-4-2'},{geometry_version:0},{geometry_version:'2'},{status:'superseded'},{published_at:'invalid'},{rollback_of_version:null},{rollback_of_version:2}]) {const f=fixture('formation','ok',[{...row,...patch}]);assert.equal((await f.run(f.request())).status,503);assert.equal(f.calls.writes.length,1);}
});
