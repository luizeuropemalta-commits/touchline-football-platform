import test from 'node:test';import assert from 'node:assert/strict';import {mkdirSync,readFileSync,existsSync} from 'node:fs';import path from 'node:path';import {chromium,webkit,expect} from '@playwright/test';
import {bundleIsolatedBrowserFixture} from './helpers/touchline-isolated-browser-bundle.mts';
import {getExchangeNegotiationCopy,getExchangeRecoveryLabel} from '../lib/touchlineFantasy/exchange-negotiations-i18n.ts';
const id=(n:number)=>`00000000-0000-4000-8000-${String(n).padStart(12,'0')}`;
const origin='https://exchange-command-fixture.invalid';
const own={playerId:id(5),clubId:id(9),name:'Synthetic Own Player',valueTc:80_000_000,position:'MID',primaryDetail:'CM'};
const other={...own,playerId:id(6),name:'Synthetic Incoming Player',valueTc:100_000_000};
const discovery={version:1,accountId:id(1),seasonId:id(2),collectionRevision:7,ownListedIds:[id(5)],reservations:[],proposals:[],listings:[{owner:{accountId:id(1),name:'Synthetic Owner'},collectionRevision:7,player:own},{owner:{accountId:id(4),name:'Synthetic Counterpart'},collectionRevision:8,player:other}]};
test('isolated real Exchange browser selection confirmation receipt and unknown outcome', {skip:process.env.TOUCHLINE_RUN_EXCHANGE_COMMAND_BROWSER!=='1',timeout:120000},async()=>{
 const out=process.env.TOUCHLINE_EXCHANGE_CAPTURE_DIR;assert.ok(out&&path.isAbsolute(out));mkdirSync(out,{recursive:true});
 const bundle=bundleIsolatedBrowserFixture({entryPath:'components/touchline/market/ClubOwnerExchangeHub.tsx',requiredSources:['components/touchline/market/ExchangeNegotiations.tsx','lib/touchlineFantasy/exchange-command-client.ts','lib/touchlineFantasy/exchange-discovery.ts'],mountScript:`const Hub=loadEntry().default;window.reloads=0;window.fixtureProps.onCommitted=()=>window.reloads++;flushSync(()=>root.render(React.createElement(Hub,window.fixtureProps)));`});
 const engine=process.env.TOUCHLINE_EXCHANGE_ENGINE==='webkit'?webkit:chromium;const browser=await engine.launch({headless:true});
 try{for(const locale of ['pt-BR','ar-SA'])for(const width of [1280,390]){
  const context=await browser.newContext({viewport:{width,height:844},serviceWorkers:'block',reducedMotion:'reduce'});const page=await context.newPage();const errors:string[]=[];const commands:unknown[]=[];let unknown=false;
  page.on('pageerror',e=>errors.push(e.message));
  const catalogue=[own,other].map((p,i)=>({id:p.playerId,canonicalPlayerId:p.playerId,name:p.name,shortName:i?'Incoming':'Outgoing',role:'midfielder',position:'CM',clubName:i?'Chelsea':'Manchester City',shirtNumber:i?10:8,countryCode3:'ENG',marketValue:'',marketValueSource:'verified',cardTier:i?'ruby-red':'emerald-green',touchlinePoints:12,editorialCard:{tierKey:i?'ruby-red':'emerald-green',cardPrice:{amountMinor:1500,currency:'TC'},marketValueEur:p.valueTc,marketValueState:'verified',lastReviewedAt:'2026-10-25T00:00:00Z'}}));
  const props={locale,draftLocalesEnabled:true,expectedAccountId:id(1),ready:true,plan:'standard',catalogue,state:{seasonId:id(2),revision:7,plan:'standard',balanceEur:200_000_000,coach:null,receipts:[],players:Array.from({length:35},(_,i)=>({playerId:i===20?id(5):id(100+i),area:i<11?'starters':i<20?'reserves':'outside',slot:i<11?i:i<20?i-11:i-20,valueEur:80_000_000}))}};
  const safe=(s:string)=>s.replace(/<\/script/gi,'<\\/script');
  const html=`<!doctype html><html lang="${locale}" dir="${locale==='ar-SA'?'rtl':'ltr'}"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><style>*{box-sizing:border-box}body{margin:0;background:#10251c;color:#edf3ee;font:16px Arial}button,select{font:inherit}#root{padding:20px}${bundle.css}</style><div id="root"></div><script>window.fixtureProps=${safe(JSON.stringify(props))}</script><script>${safe(bundle.script)}</script>`;
  await context.route('**/*',async route=>{const req=route.request(),url=new URL(req.url());
   if(url.origin!==origin)return route.abort();
   if(url.pathname==='/fixture')return route.fulfill({contentType:'text/html',body:html});
   if(url.pathname==='/api/touchline-fantasy/exchange'&&req.method()==='GET')return route.fulfill({json:{ok:true,discovery}});
   if(url.pathname==='/api/touchline-fantasy/exchange'&&req.method()==='POST'){
    const body=req.postDataJSON();commands.push(body);if(unknown)return route.fulfill({status:503,json:{ok:false,error:'CLUB_STORAGE_UNAVAILABLE'}});
    return route.fulfill({json:{ok:true,accountId:id(1),seasonId:id(2),proposalId:body.command.proposalId,status:'pending',replayed:false,terms:{proposer:{accountId:id(1),name:'Synthetic Owner'},accepter:{accountId:id(4),name:'Synthetic Counterpart'},outgoing:own,incoming:other,quote:{feeTc:5_000_000,bonusTc:2_500_000,retiredTc:2_500_000,compensationTc:-20_000_000}}}});
   }
   if(url.pathname==='/api/touchline-fantasy/exchange/history')return route.fulfill({json:{ok:true,history:{version:1,status:'confirmed',accountId:id(1),seasonId:id(2),collectionRevision:7,coverage:'complete',seasonNegotiationIncomeTc:0,receipts:[{id:id(40),occurredAt:'2026-10-25T20:00:00Z',counterpart:{accountId:id(4),name:'Synthetic Counterpart'},proposer:{accountId:id(1),name:'Synthetic Owner'},given:own,received:other,difference:{direction:'paid',amountTc:20_000_000},feeTc:5_000_000,bonusTc:0,balanceAfterTc:175_000_000}]}}});
   const file=path.resolve('public',`.${decodeURIComponent(url.pathname)}`);if(file.startsWith(path.resolve('public')+path.sep)&&existsSync(file))return route.fulfill({contentType:file.endsWith('.svg')?'image/svg+xml':file.endsWith('.webp')?'image/webp':file.endsWith('.png')?'image/png':'application/octet-stream',body:readFileSync(file)});return route.abort();
  });
  try{await page.goto(origin+'/fixture');const text=getExchangeNegotiationCopy(locale);await page.locator('nav button').first().click();const dialog=page.getByRole('dialog');await expect(dialog.getByText(text.market,{exact:true})).toBeVisible();await dialog.locator('select').selectOption(id(5));await dialog.getByRole('button',{name:text.propose,exact:true}).click();await expect(dialog.getByRole('heading',{name:text.incoming,exact:true})).toBeVisible();assert.equal(commands.length,0);await dialog.evaluate(e=>{e.parentElement!.scrollTop=0;});await page.evaluate(()=>new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve))));
   assert.equal(await dialog.evaluate(e=>e.scrollWidth>e.clientWidth+1),false);await page.waitForFunction(()=>Array.from(document.images).every(i=>i.complete));assert.equal(await page.locator('img').evaluateAll(imgs=>imgs.every(i=>(i as HTMLImageElement).naturalWidth>0)),true,'all card image assets must load');await page.screenshot({path:path.join(out,`exchange-${engine.name()}-${width}-${locale}-confirmation.png`),fullPage:true});
   await dialog.getByRole('button',{name:text.confirm,exact:true}).click();await expect.poll(()=>commands.length).toBe(1);await expect.poll(()=>page.evaluate('window.reloads')).toBe(1);
   await page.keyboard.press('Escape');await page.locator('nav button').nth(1).click();await expect(page.getByRole('dialog')).toContainText('Synthetic Incoming Player');await page.screenshot({path:path.join(out,`exchange-${engine.name()}-${width}-${locale}-receipt.png`),fullPage:true});
   await page.keyboard.press('Escape');await page.locator('nav button').first().click();await dialog.locator('select').selectOption(id(5));await dialog.getByRole('button',{name:text.propose,exact:true}).click();unknown=true;await dialog.getByRole('button',{name:text.confirm,exact:true}).click();await expect(dialog.getByText(text.unknown).first()).toBeVisible();assert.equal(commands.length,2);await expect(dialog.getByRole('button',{name:text.propose,exact:true})).toBeDisabled();
   await page.keyboard.press('Escape');await page.locator('nav button').first().click();await expect(dialog.getByText(text.unknown).first()).toBeVisible();await expect(dialog.getByRole('button',{name:text.propose,exact:true})).toBeDisabled();assert.equal(commands.length,2);await page.reload();await page.locator('nav button').first().click();await expect(page.getByRole('dialog').getByText(text.unknown).first()).toBeVisible();await expect(page.getByRole('dialog').getByRole('button',{name:text.propose,exact:true})).toBeDisabled();assert.equal(commands.length,2);unknown=false;await page.getByRole("dialog").getByRole("button",{name:getExchangeRecoveryLabel(locale),exact:true}).click();await expect.poll(()=>commands.length).toBe(3);assert.deepEqual(commands[2],commands[1],"explicit recovery reuses exact persisted envelope and proposal ID");assert.deepEqual(errors,[]);
  }finally{await context.close();}
 }}finally{await browser.close();}
});
