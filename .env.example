NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_TRIAL_DAYS=14
STRIPE_AUTOMATIC_TAX=false

STRIPE_PRICE_STARTER_AGENT_MONTHLY=price_
STRIPE_PRICE_STARTER_AGENT_YEARLY=price_
STRIPE_PRICE_PRO_AGENT_MONTHLY=price_
STRIPE_PRICE_PRO_AGENT_YEARLY=price_
STRIPE_PRICE_ELITE_AGENCY_MONTHLY=price_
STRIPE_PRICE_ELITE_AGENCY_YEARLY=price_

STRIPE_PRICE_CLUB_BASIC_MONTHLY=price_
STRIPE_PRICE_CLUB_BASIC_YEARLY=price_
STRIPE_PRICE_CLUB_PRO_MONTHLY=price_
STRIPE_PRICE_CLUB_PRO_YEARLY=price_
STRIPE_PRICE_CLUB_ELITE_MONTHLY=price_
STRIPE_PRICE_CLUB_ELITE_YEARLY=price_

STRIPE_PRICE_ACADEMY_MONTHLY=price_
STRIPE_PRICE_ACADEMY_YEARLY=price_
STRIPE_PRICE_FOUNDER_YEARLY=price_

# Daily football data sync.
MARKET_SYNC_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-the-same-secret-if-using-vercel-cron

# Provider-independent Football Data Core.
FOOTBALL_DATA_PROVIDER=sportmonks
FOOTBALL_DATA_VALIDATION_SECRET=replace-with-a-long-random-secret
FOOTBALL_DATA_SYNC_SECRET=replace-with-a-long-random-secret
FOOTBALL_DATA_VALIDATION_PLAYER_QUERY=Messi
FOOTBALL_DATA_VALIDATION_TEAM_ID=
FOOTBALL_DATA_VALIDATION_COACH_ID=
FOOTBALL_DATA_VALIDATION_FIXTURE_DATE=
FOOTBALL_DATA_VALIDATION_COMPETITION_ID=
FOOTBALL_DATA_VALIDATION_SEASON_ID=

# Sportmonks provider. Server-side only. Never expose this as NEXT_PUBLIC_*.
SPORTMONKS_API_TOKEN=your-sportmonks-token
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
# Starter foundation sync. Replace with one league/club available in your Sportmonks Starter plan.
SPORTMONKS_STARTER_LEAGUE_ID=8
SPORTMONKS_STARTER_CLUB_ID=19

# Smart cache TTLs by data type.
FOOTBALL_DATA_CACHE_TTL_STATIC_SECONDS=2592000
FOOTBALL_DATA_CACHE_TTL_DAILY_SECONDS=86400
FOOTBALL_DATA_CACHE_TTL_LIVE_SECONDS=15
FOOTBALL_DATA_CACHE_TTL_HISTORICAL_SECONDS=604800

# Automatic Touchline link index.
# This indexes Transfermarkt links already discovered inside Touchline activity.
# It does not crawl third-party sites directly.
TOUCHLINE_LINK_INDEX_DAILY_LIMIT=1000
TOUCHLINE_LINK_INDEX_SYNC_LIMIT=1000

# Transfermarkt Link Registry.
# Safe mode: stores profile links/IDs/previews only. External checking is opt-in and rate limited.
# Profile enrichment is user-triggered when opening a saved player profile. Set false to disable.
TRANSFERMARKT_PROFILE_ENRICHMENT_ENABLED=true
TRANSFERMARKT_SYNC_ENABLED=false
TRANSFERMARKT_SYNC_SECRET=replace-with-a-long-random-secret
TRANSFERMARKT_RATE_LIMIT_MS=2500
