# Daily football market sync.
# Use an authorized/licensed football data provider endpoint. Do not scrape protected sites in production.
MARKET_SYNC_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-the-same-secret-if-using-vercel-cron
FOOTBALL_MARKET_DATA_API_URL=https://your-authorized-provider.example.com/player-market
FOOTBALL_MARKET_DATA_API_KEY=your-provider-api-key

# Free/demo option: API-Football by API-SPORTS.
# Create a free account, copy the key, and set player external_market_provider to api-football.
API_FOOTBALL_KEY=your-api-football-free-key
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_SEASON=2025
