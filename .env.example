NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
NEXT_PUBLIC_ENABLE_APPLE_AUTH=false
NEXT_PUBLIC_ENABLE_FACEBOOK_AUTH=false
# Canonical public origin used by confirmation, recovery and OAuth callbacks.
# Keep this on the official full Arena deployment, never on an old preview project.
NEXT_PUBLIC_TOUCHLINE_AUTH_ORIGIN=https://touchline.com.br
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional dedicated HMAC secret for short-lived password-recovery grants.
# Falls back to SUPABASE_SERVICE_ROLE_KEY when omitted.
TOUCHLINE_AUTH_RECOVERY_SECRET=replace-with-a-long-random-secret

TOUCHLINE_SITE_OFFLINE=false
TOUCHLINE_OWNER_EMAILS=owner@example.com
# Optional comma-separated hostnames or LAN IPs for mobile testing against `next dev`.
# Do not include a protocol or port. Example: 192.168.1.50
TOUCHLINE_DEV_ORIGINS=
# Server-only opt-in for writing Visual QA layouts on a private local machine.
# Keep disabled everywhere else. This never trusts the Host request header.
TOUCHLINE_ALLOW_LOCAL_EDITOR=0

STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# TouchLine V2.10 uses a separate, server-only Stripe Test Mode boundary.
# Never set this to live; never commit any actual credential or ID.
TOUCHLINE_STRIPE_MODE=test
TOUCHLINE_STRIPE_TEST_SECRET_KEY=sk_test_your_key
TOUCHLINE_STRIPE_TEST_WEBHOOK_SECRET=whsec_your_webhook_secret
TOUCHLINE_STRIPE_TEST_INITIAL_ACTIVATION_PRICE_ID=price_test_replace_with_server_configured_id

# Provider-independent Football Data Core.
FOOTBALL_DATA_PROVIDER=sportmonks
FOOTBALL_DATA_VALIDATION_SECRET=replace-with-a-long-random-secret
FOOTBALL_DATA_SYNC_SECRET=replace-with-a-long-random-secret
FOOTBALL_DATA_VALIDATION_PLAYER_QUERY=Messi
FOOTBALL_DATA_VALIDATION_TEAM_ID=
FOOTBALL_DATA_VALIDATION_COACH_ID=
FOOTBALL_DATA_VALIDATION_FIXTURE_DATE=
FOOTBALL_DATA_VALIDATION_COMPETITION_ID=
FOOTBALL_DATA_VALIDATION_SEASON_ID=

# Sportmonks provider. Server-side only. Never expose this as NEXT_PUBLIC_*.
SPORTMONKS_API_TOKEN=your-sportmonks-token
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
SPORTMONKS_ROOT_BASE_URL=https://api.sportmonks.com/v3
SPORTMONKS_PREMIER_LEAGUE_ID=8
# Starter foundation sync. Replace with one league/club available in your Sportmonks Starter plan.
SPORTMONKS_STARTER_LEAGUE_ID=8
SPORTMONKS_STARTER_CLUB_ID=19

TOUCHLINE_CURRENT_SEASON=2026
TOUCHLINE_PLAYER_CACHE_TTL_SECONDS=21600

# Smart cache TTLs by data type.
FOOTBALL_DATA_CACHE_TTL_STATIC_SECONDS=2592000
FOOTBALL_DATA_CACHE_TTL_DAILY_SECONDS=86400
FOOTBALL_DATA_CACHE_TTL_LIVE_SECONDS=15
FOOTBALL_DATA_CACHE_TTL_HISTORICAL_SECONDS=604800
FOOTBALL_DATA_CACHE_MAX_ENTRIES=500
FOOTBALL_SQUAD_SNAPSHOT_TTL_SECONDS=86400

# Local player-profile audit only. These values are not required in production.
TOUCHLINE_AUDIT_BASE_URL=http://127.0.0.1:3001
TOUCHLINE_EXPECTED_PLAYER_COUNT=
